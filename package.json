{
  "name": "csm-dev-wallet",
  "version": "2.5.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/exromany/csm-dev-wallet"
  },
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "exports": {
    "./playwright": {
      "types": "./dist/playwright/index.d.ts",
      "import": "./dist/playwright/index.js"
    }
  },
  "files": [
    "dist/"
  ],
  "engines": {
    "node": ">=24"
  },
  "description": "Chrome extension for QA testing Lido CSM widget — connect as any operator address",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "test:e2e": "wxt build && npx tsx test/e2e/run-all.ts",
    "screenshot:store": "wxt build && npx tsx scripts/store-screenshot.ts",
    "test:e2e:only": "npx tsx",
    "prepare": "wxt prepare",
    "build:playwright": "tsup playwright/index.ts --format esm --dts --outDir dist/playwright --external playwright --external viem",
    "build:package": "wxt build && pnpm run build:playwright && cp -r .output/chrome-mv3 dist/extension"
  },
  "dependencies": {
    "@lidofinance/lido-csm-sdk": "^2.3.0-alpha.2",
    "@lidofinance/lido-ethereum-sdk": "^4.8.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "viem": "^2.55.19"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "~6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/chrome": "^0.1.43",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.2.0",
    "@wxt-dev/module-react": "^1.2.2",
    "jsdom": "^28.1.0",
    "oxlint": "^1.80.0",
    "playwright": "^1.62.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "wxt": "^0.20.27"
  },
  "volta": {
    "node": "24.13.1"
  }
}
